/* SUPER+H kisayol yardimi (keybinds-help.sh). Tek sutun, aranabilir liste. */
* {
    bg:              rgba ( 30, 30, 46, 95 % );
    bg-alt:          rgba ( 49, 50, 68, 100 % );
    fg:              rgba ( 205, 214, 244, 100 % );
    fg-dim:          rgba ( 166, 173, 200, 100 % );
    background-color: transparent;
    text-color:      var(fg);
    font:            "JetBrainsMono Nerd Font 11";
}

window {
    width:            820px;
    border-radius:    18px;
    border:           2px;
    border-color:     var(border-clr);
    background-color: var(bg);
    padding:          20px;
}

mainbox {
    children: [ inputbar, message, listview ];
    spacing:  12px;
}

inputbar {
    background-color: var(bg-alt);
    border-radius:    14px;
    padding:          12px 16px;
    children:         [ prompt, entry ];
    spacing:          10px;
}

prompt {
    text-color: var(accent);
    font:       "JetBrainsMono Nerd Font Bold 12";
}

entry {
    placeholder:       "Ara... (örn. ekran, pencere, ses)";
    placeholder-color: var(fg-dim);
}

message {
    padding: 0px 6px;
}

textbox {
    text-color: var(fg-dim);
    font:       "JetBrainsMono Nerd Font 9";
}

listview {
    columns:      1;
    lines:        17;
    spacing:      2px;
    scrollbar:    true;
    fixed-height: true;
}

scrollbar {
    handle-width:     4px;
    handle-color:     var(border-clr);
    background-color: transparent;
}

element {
    padding:       5px 12px;
    border-radius: 8px;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color:       var(fg);
}

/* Kategori basliklari (-a ile isaretlenen satirlar) */
element normal.active, element alternate.active {
    background-color: transparent;
    text-color:       var(accent);
}

element selected.normal, element selected.active {
    background-color: var(selected-bg);
    text-color:       var(accent);
}

element-text {
    text-color:     inherit;
    vertical-align: 0.5;
}

/* accent, border-clr, selected-bg: ~/.config/hypr/accent-apply.sh uretir */
@import "colors.rasi"
